# ignore app cache folder
.cache/

# captured photos (local test data, not source)
data/captures/

# Piper TTS venv (host-only, see README "Voz: Piper TTS") and downloaded
# voice model (binary asset, ~60MB, fetched by the install steps instead)
scripts/.venv-piper/
data/piper/

# any other virtualenv, wherever it ends up
.venv/
venv/
*.egg-info/

# Python bytecode
__pycache__/
*.pyc

# runtime IPC files auto-created by the app/daemon on startup (FIFO trigger,
# Unix socket) -- not source, and git can't track a fifo/socket meaningfully
data/trigger
data/bluetooth_audio.sock

# IP resuelta por scripts/server_ip_resolver.py -- estado de runtime
# específico de esta red/PC, no algo para versionar
data/server_ip.txt

# Credencial de vinculación de este equipo físico (ver
# docs/VINCULACION-USB.md) -- nunca es código fuente, es secreta
data/device_credentials.json

# Código de enlace (extensión v1.1, ver docs/VINCULACION-USB.md) -- mismo
# tratamiento que la credencial de arriba, no es código fuente
data/pairing_code.txt

# Estado de runtime del cliente de la API web de administración (ver
# docs/API-DISPOSITIVO.md y blindia/backend/): cola de identificaciones
# sin confirmar, contador de event_id, y última versión de configuración
# remota aplicada -- ninguno es código fuente, todos son estado local.
data/identification_queue.json
data/identification_counter.txt
data/remote_config_version.txt

# Claude Code local machine settings (permissions etc.) -- personal to this
# board/user, not project config; see .claude/settings.json if one exists
# for settings meant to be shared
.claude/settings.local.json
